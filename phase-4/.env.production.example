# Production Environment Configuration Template (Vercel + Neon PostgreSQL)
# Configure actual values in Vercel Environment Variables.
# Never commit real credentials or secrets.

DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require"

# Generate a new secret using: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_NEW_64_CHARACTER_HEX_SECRET"

# Vercel automatically provides NODE_ENV.
# NODE_ENV="production"

APP_URL="https://YOUR-PROJECT.vercel.app"
